{
  "name": "copy-rights",
  "version": "1.0.0",
  "private": true,
  "description": "Firefox extension: stop sites from messing with selection, copy, paste and right-click.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "web-ext run --url test/torture.html",
    "lint": "web-ext lint --ignore-files 'test/**' 'node_modules/**'",
    "build": "web-ext build --overwrite-dest --ignore-files 'test/**' 'node_modules/**' package.json package-lock.json README.md",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "selenium-webdriver": "^4.27.0",
    "web-ext": "^8.3.0"
  }
}
